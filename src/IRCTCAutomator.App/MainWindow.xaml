<Window x:Class="IRCTCAutomator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IRCTC Automator" Width="720" Height="520" WindowStartupLocation="CenterScreen">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="IRCTC Automator" FontSize="30" FontWeight="Bold"/>
<TextBlock Grid.Row="1" Margin="0,8,0,20" Text="Configuration-driven booking preparation" FontSize="15" Opacity="0.7"/>
<Border Grid.Row="2" Padding="18" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8"><StackPanel>
<TextBlock Text="Booking configuration" FontWeight="SemiBold" FontSize="17"/>
<TextBlock x:Name="ConfigSummary" Margin="0,10,0,20" TextWrapping="Wrap"/>
<TextBlock Text="The application will open IRCTC and prepare the permitted booking steps. CAPTCHA, OTP and payment remain user-controlled." TextWrapping="Wrap" Foreground="#555"/>
</StackPanel></Border>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
    <Button x:Name="StartButton" Content="Start Booking Preparation" Padding="18,10" Click="StartButton_Click"/>
    <Button Content="Close" Padding="18,10" Margin="10,0,0,0" Click="Close_Click"/></StackPanel>
</Grid></Window>
